{
    "name": "sebastian/phar-site-generator",
    "description": "Tool that generates an HTML page, RSS feed, and Phive metadata for a PHAR repository",
    "homepage": "https://github.com/sebastianbergmann/phar-site-generator",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Sebastian Bergmann",
            "email": "sebastian@phpunit.de",
            "role": "lead"
        }
    ],
    "support": {
        "issues": "https://github.com/sebastianbergmann/phar-site-generator/issues"
    },
    "prefer-stable": true,
    "require": {
        "php": "^8.4",
        "ext-dom": "*",
        "ext-phar": "*",
        "phpunit/php-text-template": "^6.0.1",
        "sebastian/cli-parser": "^5.0.1",
        "sebastian/version": "^7.1.0"
    },
    "autoload": {
        "classmap": [
            "src/"
        ]
    },
    "config": {
        "platform": {
            "php": "8.4.27"
        },
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "5.9-dev"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4.6"
    }
}
